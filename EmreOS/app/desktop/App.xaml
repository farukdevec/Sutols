<Application x:Class="AtlasDesktop.App"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  StartupUri="MainWindow.xaml">
  <Application.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#C4FFF7"/>
      <Setter Property="Background" Value="#08161D"/>
      <Setter Property="BorderBrush" Value="#136E67"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="Padding" Value="16,12"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Foreground" Value="#13E5CF"/>
          <Setter Property="Background" Value="#0B2026"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Application.Resources>
</Application>
