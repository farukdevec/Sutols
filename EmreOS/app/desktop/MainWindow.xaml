<Window x:Class="AtlasDesktop.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Atlas — EmreOS" Width="1240" Height="780" MinWidth="960" MinHeight="620"
  Background="#02090C" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True" ResizeMode="CanResize">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#BFFFE1"/><Setter Property="Background" Value="#0A1C19"/>
      <Setter Property="BorderBrush" Value="#1B7651"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,4"/>
    </Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <TextBlock Text="ATLAS" FontSize="25" FontWeight="SemiBold" Foreground="#63FFAE" VerticalAlignment="Center"/>
        <TextBlock Text="EMREOS  /  LOCAL KNOWLEDGE GRAPH" Margin="16,7,0,0" FontFamily="Consolas" FontSize="11" Foreground="#79A99A"/>
      </StackPanel>
      <TextBlock x:Name="StatusText" Text="● LOCAL INDEX READY" Foreground="#63FFAE" FontFamily="Consolas" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#071411" BorderBrush="#1B7651" BorderThickness="1" Padding="12">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="BİLGİ KAYNAKLARI" Margin="6,7,6,10" FontFamily="Consolas" FontSize="10" Foreground="#79A99A"/>
            <TextBlock x:Name="NodeCountText" Margin="6,0,6,12" Foreground="#BFFFE1" FontFamily="Consolas" FontSize="12"/>
            <Button Content="↻  GRAFİĞİ YENİLE" Click="RefreshGraphClick" Foreground="#63FFAE"/>
            <Button Content="▣  KASAYI AÇ" Click="OpenVaultClick"/>
            <Button Content="+  OTURUM KAYDET" Click="SaveClick" Foreground="#63FFAE"/>
            <Button Content="↻  İNDEKSİ DERLE" Click="CompileClick" Foreground="#FFE38A"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <TextBlock Text="ÇALIŞMA ALANLARI" Margin="6,10,6,4" FontFamily="Consolas" FontSize="10" Foreground="#79A99A"/>
            <ListBox x:Name="WorkspaceList" DisplayMemberPath="Name" Height="104" Background="#04100D" Foreground="#BFFFE1" BorderBrush="#1B7651" SelectionChanged="WorkspaceSelectionChanged"/>
            <Button Content="▶  CODEX'İ AÇ" Click="OpenCodexClick" Foreground="#63FFAE"/>
              <ComboBox x:Name="ToolList" SelectedIndex="0" Height="30" Background="#04100D" Foreground="#63FFAE" BorderBrush="#1B7651">
              <ComboBoxItem Content="OpenCode" Tag="opencode" Foreground="#06351F" Background="#BFFFE1"/><ComboBoxItem Content="Codex" Tag="codex" Foreground="#06351F" Background="#BFFFE1"/><ComboBoxItem Content="Claude Code" Tag="claude" Foreground="#06351F" Background="#BFFFE1"/><ComboBoxItem Content="Aider" Tag="aider" Foreground="#06351F" Background="#BFFFE1"/><ComboBoxItem Content="Gemini CLI" Tag="gemini" Foreground="#06351F" Background="#BFFFE1"/><ComboBoxItem Content="Terminal / özel araç" Tag="terminal" Foreground="#06351F" Background="#BFFFE1"/>
            </ComboBox>
            <Button Content="▶  SEÇİLİ ARAÇLA AÇ" Click="OpenSelectedToolClick" Foreground="#BFFFE1"/>
            <Button Content="+  KLASÖR EKLE" Click="AddWorkspaceClick"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Grid Grid.Column="1" Margin="18,0">
        <Canvas x:Name="GraphCanvas" Background="#02090C" SizeChanged="GraphSizeChanged" MouseDown="GraphBackgroundClick" ClipToBounds="True"/>
        <Border IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Background="#06130E" BorderBrush="#1B7651" BorderThickness="1" CornerRadius="12" Padding="12,7">
          <TextBlock Text="GERÇEK MARKDOWN DOSYALARI  •  TIKLA: BAĞLAMI AÇ  •  HOVER: ÖZET" FontFamily="Consolas" FontSize="10" Foreground="#79A99A"/>
        </Border>
      </Grid>

      <Border Grid.Column="2" Background="#071411" BorderBrush="#1B7651" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <TextBlock Text="BAĞLAM ÇEKMECESİ" Margin="20,18,20,4" FontFamily="Consolas" FontSize="10" Foreground="#79A99A"/>
          <StackPanel Grid.Row="1" Margin="20,0,20,10">
            <TextBlock x:Name="ContextTitle" FontSize="20" FontWeight="SemiBold" Foreground="#63FFAE"/>
            <TextBlock x:Name="SummaryText" Margin="0,5,0,0" Foreground="#BFFFE1" TextWrapping="Wrap"/>
            <TextBlock x:Name="LinksText" Margin="0,7,0,0" Foreground="#79A99A" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap"/>
          </StackPanel>
          <TextBox x:Name="ContentBox" Grid.Row="2" Margin="20,0" Background="#06110D" Foreground="#D8FFE9" BorderBrush="#164C37" BorderThickness="1" Padding="10" FontFamily="Segoe UI" FontSize="14" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" IsReadOnly="True"/>
          <StackPanel Grid.Row="3" Margin="20,10,20,18">
            <TextBlock x:Name="PathText" Margin="0,0,0,7" FontFamily="Consolas" FontSize="10" Foreground="#79A99A" TextWrapping="Wrap"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
              <TextBox x:Name="AtlasPromptBox" Grid.Column="0" MinHeight="108" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" Background="#06110D" Foreground="#D8FFE9" BorderBrush="#1B7651" Padding="10"/>
              <Button Grid.Column="1" Content="ATLAS'A&#x0a;SOR" Click="AskAtlasClick" Margin="8,0,0,0" Foreground="#63FFAE" VerticalAlignment="Stretch"/>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="LOCAL-FIRST • WIKILINK + BACKLINK GRAPH • OPENCode / CODEX / TERMINAL UYUMLU" FontFamily="Consolas" FontSize="10" Foreground="#568174" VerticalAlignment="Bottom"/>
  </Grid>
</Window>
