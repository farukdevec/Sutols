# Cloudflare R2 (S3 uyumlu) bağlantı bilgileri
# Gerçek değerleri bu dosyaya değil, aynı klasördeki .env dosyasına yazın.
# .env dosyası git ile paylaşılmaz (bkz. functions/.gitignore).

# Cloudflare dashboard > R2 > Account ID
R2_ACCOUNT_ID=

# R2 > Manage R2 API Tokens'den oluşturulan token'ın parçaları
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Bucket adı (ör. sutol)
R2_BUCKET_NAME=

# S3 API endpoint: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Opsiyonel: public model URL öneki.
# Boş bırakılırsa https://pub-<ACCOUNT_ID>.r2.dev varsayılanı kullanılır.
# Public erişimi olmayan bucket'lar için kendi CDN domaininizi yazın.
R2_PUBLIC_BASE_URL=
